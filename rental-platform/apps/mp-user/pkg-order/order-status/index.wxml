<view class="container">
  <view class="page-header">
    <text class="page-header__title">订单详情</text>
    <text class="page-header__desc">订单 ID：{{orderId}}</text>
  </view>

  <section-card title="当前状态">
    <view class="vehicle-item__price" style="margin-bottom: 16rpx;">{{status}}</view>
    <json-block content="{{orderJson}}" emptyText="加载中…" />
    <view class="btn-group">
      <button bindtap="handleRefresh">刷新状态</button>
      <button type="primary" bindtap="handleBackVehicles">返回租车</button>
    </view>
  </section-card>
</view>
