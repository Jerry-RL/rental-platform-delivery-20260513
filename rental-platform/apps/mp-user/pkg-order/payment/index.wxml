<view class="container">
  <view class="card">
    <view class="title">支付确认</view>
    <view>订单ID：{{orderId}}</view>
    <view>支付单ID：{{paymentId}}</view>
    <view>金额：¥{{amount}}</view>
    <picker mode="selector" range="{{cancelReasonLabels}}" value="{{cancelReasonIndex}}" bindchange="onCancelReasonChange">
      <view class="picker">取消原因：{{cancelReasonLabels[cancelReasonIndex]}}</view>
    </picker>
    <button class="btn" type="primary" bindtap="handlePay" loading="{{paying}}">立即支付</button>
    <button class="btn" bindtap="handleRetryPrepay" loading="{{prepayLoading}}">重试拉起支付参数</button>
    <button class="btn" type="warn" bindtap="handleCancelOrder" loading="{{cancelLoading}}">取消订单</button>
    <view class="status">{{message}}</view>
  </view>
</view>
