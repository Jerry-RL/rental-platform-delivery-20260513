<view class="container">
  <view class="page-header">
    <text class="page-header__title">支付结果</text>
    <text class="page-header__desc">轮询中，请稍候…</text>
  </view>

  <section-card title="支付状态" desc="轮询 {{pollCount}} / {{maxPollCount}}">
    <view class="col">
      <view><text class="muted">订单 </text>{{orderId}}</view>
      <view><text class="muted">支付单 </text>{{paymentId}}</view>
      <view class="vehicle-item__price">{{status}}</view>
    </view>
    <json-block content="{{resultJson}}" emptyText="等待支付结果…" />
    <view class="btn-group">
      <button bindtap="handleRefreshStatus">手动刷新</button>
      <button wx:if="{{orderId}}" bindtap="handleViewOrderStatus">查看订单</button>
      <button type="primary" bindtap="handleBackVehicles">返回租车</button>
    </view>
  </section-card>
</view>
