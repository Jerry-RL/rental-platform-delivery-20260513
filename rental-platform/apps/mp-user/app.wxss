page {
  background: #f1f5f9;
  color: #0f172a;
  font-size: 28rpx;
  line-height: 1.5;
}

.container {
  padding: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.page-header {
  margin-bottom: 24rpx;
}

.page-header__title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #0f172a;
}

.page-header__desc {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #64748b;
}

.row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.row--wrap {
  flex-wrap: wrap;
}

.col {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.input,
.picker {
  flex: 1;
  background: #f8fafc;
  border: 2rpx solid #e2e8f0;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.input:focus,
.picker:active {
  border-color: #1677ff;
}

.btn-group {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 8rpx;
}

.btn-group--row {
  flex-direction: row;
  flex-wrap: wrap;
}

.btn-group .btn {
  margin-top: 0;
}

.btn {
  margin-top: 8rpx;
}

.muted {
  color: #64748b;
  font-size: 26rpx;
}

.label {
  display: block;
  margin-bottom: 8rpx;
  font-size: 24rpx;
  color: #64748b;
}

.vehicle-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f1f5f9;
}

.vehicle-item:last-child {
  border-bottom: none;
}

.vehicle-item__info {
  flex: 1;
  font-size: 28rpx;
}

.vehicle-item__price {
  color: #1677ff;
  font-weight: 600;
}

/* legacy aliases */
.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(15, 23, 42, 0.06);
}

.title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 18rpx;
}

.sub-title {
  color: #64748b;
  margin-bottom: 12rpx;
  font-size: 26rpx;
}

.json {
  background: #0f172a;
  color: #e2e8f0;
  border-radius: 16rpx;
  padding: 20rpx;
  white-space: pre-wrap;
  word-break: break-all;
  font-size: 22rpx;
}

.status {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  background: rgba(22, 119, 255, 0.08);
  border-radius: 12rpx;
  color: #1677ff;
  font-size: 26rpx;
}
