<view class="container">
  <view class="card">
    <view class="title">用户登录</view>
    <view class="col">
      <input class="input" placeholder="手机号" value="{{phone}}" bindinput="onPhoneInput" />
      <input class="input" placeholder="密码" password value="{{password}}" bindinput="onPasswordInput" />
      <button class="btn" type="primary" bindtap="handleLogin">登录并进入租车页</button>
      <text class="status">{{message}}</text>
    </view>
  </view>
</view>
