<view class="container">
  <view class="card">
    <view class="title">批量违章查询</view>
    <textarea class="input" placeholder="每行一个车牌或车辆ID" value="{{vehiclesText}}" bindinput="onVehiclesInput" />
    <button class="btn" type="primary" bindtap="handleCreateTask">创建批量任务</button>
    <view class="status">{{message}}</view>
  </view>

  <view class="card">
    <view class="sub-title">任务结果</view>
    <text class="json">{{taskJson}}</text>
  </view>
</view>
