<view class="container">
  <view class="page-header">
    <text class="page-header__title">租车</text>
    <text class="page-header__desc">搜索可租车辆并创建订单</text>
  </view>

  <section-card title="搜索条件" desc="按城市与车型筛选">
    <view class="col">
      <view class="row">
        <input class="input" placeholder="城市，如 Shanghai" value="{{city}}" bindinput="onCityInput" />
        <input class="input" placeholder="车型，如 SUV" value="{{vehicleTypeId}}" bindinput="onVehicleTypeInput" />
      </view>
      <view class="row row--wrap">
        <picker class="picker" mode="selector" range="{{settlementModes}}" bindchange="onSettlementChange" value="{{settlementIndex}}">
          <view>结算：{{settlementModes[settlementIndex]}}</view>
        </picker>
        <picker class="picker" mode="selector" range="{{serviceModes}}" bindchange="onServiceChange" value="{{serviceIndex}}">
          <view>服务：{{serviceModes[serviceIndex]}}</view>
        </picker>
      </view>
      <picker
        wx:if="{{serviceModes[serviceIndex] === 'WITH_DRIVER'}}"
        class="picker"
        mode="selector"
        range="{{drivers}}"
        range-key="name"
        value="{{driverIndex}}"
        bindchange="onDriverChange"
      >
        <view>司机：{{drivers.length ? drivers[driverIndex].name : '暂无可用司机'}}</view>
      </picker>
      <button class="btn" type="primary" bindtap="handleSearch">查询车辆</button>
    </view>
  </section-card>

  <section-card title="可租车辆" desc="{{vehicles.length ? '共 ' + vehicles.length + ' 辆' : '请先查询'}}">
    <block wx:if="{{vehicles.length}}">
      <view wx:for="{{vehicles}}" wx:key="id" class="vehicle-item">
        <view class="vehicle-item__info">
          <text>{{item.plateNumber}} · {{item.vehicleTypeId}}</text>
          <text class="vehicle-item__price"> ¥{{item.dailyPrice}}/天</text>
        </view>
        <button size="mini" type="primary" data-vehicletypeid="{{item.vehicleTypeId}}" bindtap="handleCreateOrder">下单</button>
      </view>
    </block>
    <empty-state wx:else text="暂无车辆，请调整搜索条件" icon="🚗" />
  </section-card>

  <section-card title="订单结果" desc="创建成功后可前往支付">
    <json-block content="{{orderJson}}" emptyText="尚未创建订单" />
    <view class="btn-group" wx:if="{{latestOrderId}}">
      <button type="primary" bindtap="handleGoPay">去支付（{{latestOrderId}}）</button>
    </view>
    <status-tip message="{{message}}" />
  </section-card>
</view>
