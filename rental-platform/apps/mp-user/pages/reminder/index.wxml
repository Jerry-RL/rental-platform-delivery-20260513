<view class="container">
  <view class="page-header">
    <text class="page-header__title">提醒</text>
    <text class="page-header__desc">保险/年检到期摘要与地图选点</text>
  </view>

  <section-card title="到期摘要" desc="查看保险与年检待办数量">
    <button class="btn" type="primary" bindtap="handleLoadSummary">读取提醒摘要</button>
    <json-block content="{{summaryJson}}" emptyText="点击上方按钮加载" />
  </section-card>

  <section-card title="地图选点" desc="Key：{{mapKey}}">
    <button class="btn" bindtap="handleChooseLocation">选择起点位置</button>
    <json-block content="{{locationJson}}" emptyText="选点后显示坐标信息" />
  </section-card>

  <status-tip message="{{message}}" />
</view>
