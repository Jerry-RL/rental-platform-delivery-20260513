{
  "info": {
    "name": "Rental Platform APIs",
    "_postman_id": "9d5fce32-f977-4dcf-9dc3-1a98d32422c7",
    "description": "可直接导入 Postman/Apifox 的集合文件",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://api.rental.example.com" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Users",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Request-Id", "value": "req_{{$timestamp}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/v1/users/register", "host": ["{{baseUrl}}"], "path": ["api","v1","users","register"] },
            "body": { "mode": "raw", "raw": "{\n  \"phone\": \"13800000000\",\n  \"password\": \"Pass@123\",\n  \"verifyCode\": \"123456\"\n}" }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Request-Id", "value": "req_{{$timestamp}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/v1/users/login", "host": ["{{baseUrl}}"], "path": ["api","v1","users","login"] },
            "body": { "mode": "raw", "raw": "{\n  \"phone\": \"13800000000\",\n  \"password\": \"Pass@123\"\n}" }
          }
        }
      ]
    },
    {
      "name": "Vehicles",
      "item": [
        {
          "name": "List Vehicles",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-Request-Id", "value": "req_{{$timestamp}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/vehicles?pageNum=1&pageSize=20&sortBy=createdAt&sortOrder=desc&filter={\"status\":\"AVAILABLE\"}",
              "host": ["{{baseUrl}}"],
              "path": ["api","v1","vehicles"],
              "query": [
                { "key": "pageNum", "value": "1" },
                { "key": "pageSize", "value": "20" },
                { "key": "sortBy", "value": "createdAt" },
                { "key": "sortOrder", "value": "desc" },
                { "key": "filter", "value": "{\"status\":\"AVAILABLE\"}" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "Create Order",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "X-Request-Id", "value": "req_{{$timestamp}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/v1/orders", "host": ["{{baseUrl}}"], "path": ["api","v1","orders"] },
            "body": { "mode": "raw", "raw": "{\n  \"vehicleTypeId\": \"2ef2e83f-26af-41c1-8c74-55343c45bf43\",\n  \"pickupStoreId\": \"d6a6bfe6-f9f4-4f49-b57f-c3c4f5f4c3a1\",\n  \"returnStoreId\": \"d6a6bfe6-f9f4-4f49-b57f-c3c4f5f4c3a1\",\n  \"pickupTime\": \"2026-05-20T09:00:00Z\",\n  \"returnTime\": \"2026-05-22T09:00:00Z\"\n}" }
          }
        }
      ]
    }
  ]
}
